# ====== 构建阶段 ======
FROM node:20-alpine AS builder
WORKDIR /build

# 先拷贝 package.json（利用 Docker 层缓存）
COPY quant-frontend/package*.json ./
# 配置淘宝 npm 镜像（国内加速）
RUN npm config set registry https://registry.npmmirror.com && npm ci

# 拷贝源码并构建
COPY quant-frontend/ ./
RUN npm run build

# ====== 运行阶段 ======
FROM nginx:alpine

# 拷贝构建产物
COPY --from=builder /build/dist /usr/share/nginx/html

# Nginx 配置：SPA 路由回退 + /api 反向代理到 gateway
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
