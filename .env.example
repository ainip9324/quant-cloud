# 复制为仓库根目录的 .env。正式与 fake 联调都需要以下四项。
# JWT 和内部服务凭据使用不同的随机值，各至少 32 字节。
JWT_SECRET=
CORE_DATA_SERVICE_SECRET=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Compose 会在新库为该非 root 用户授权 quant_cloud。
MYSQL_USER=quantcloud

# 正式启动必填。fake 联调可以留空。
DEEPSEEK_API_KEY=
KNOWLEDGE_PG_PASSWORD=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_MODEL_TIMEOUT=30s

# 默认入口为 http://localhost:8088。并行运行时给不同项目设置不同的宿主机端口。
QUANT_HTTP_BIND=127.0.0.1
QUANT_HTTP_PORT=8088

# 默认直连 Bitget。仅需代理时启用并填入容器可达的地址和端口。
BITGET_PROXY_ENABLED=false
BITGET_PROXY_HOST=
BITGET_PROXY_PORT=
