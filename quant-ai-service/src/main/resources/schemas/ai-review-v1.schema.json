{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object", "additionalProperties":false,
  "required":["headline","summary","evidence","findings","riskWarnings","experimentHypotheses"],
  "properties":{
    "headline":{"type":"string","minLength":1,"maxLength":160},
    "summary":{"type":"string","minLength":1,"maxLength":1200},
    "evidence":{"type":"array","minItems":1,"maxItems":20,"items":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["candidateId","type","sequence"],"properties":{"candidateId":{"type":"string","pattern":"^E[1-9][0-9]*$"},"type":{"const":"EVENT"},"sequence":{"type":"integer","minimum":1}}},
      {"type":"object","additionalProperties":false,"required":["candidateId","type","factCode"],"properties":{"candidateId":{"type":"string","pattern":"^E[1-9][0-9]*$"},"type":{"const":"FACT"},"factCode":{"enum":["FILL_COUNT","COMPLETED_POSITION_COUNT","RETURN_RATE","MAX_DRAWDOWN","ZONE_FINAL_STATE","DATA_LIMITATION"]},"sourceId":{"type":"string","maxLength":80}},"allOf":[{"if":{"properties":{"factCode":{"const":"ZONE_FINAL_STATE"}}},"then":{"required":["sourceId"]}}]},
      {"type":"object","additionalProperties":false,"required":["candidateId","type","strategyId","version","ruleCode"],"properties":{"candidateId":{"type":"string","pattern":"^E[1-9][0-9]*$"},"type":{"const":"SPEC"},"strategyId":{"type":"string","maxLength":40},"version":{"type":"string","maxLength":40},"ruleCode":{"type":"string","maxLength":80}}}
    ]}},
    "findings":{"type":"array","minItems":1,"maxItems":10,"items":{"type":"object","additionalProperties":false,"required":["title","detail","evidenceIds"],"properties":{"title":{"type":"string","minLength":1,"maxLength":160},"detail":{"type":"string","minLength":1,"maxLength":1200},"evidenceIds":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^E[1-9][0-9]*$"}}}}},
    "riskWarnings":{"type":"array","maxItems":10,"items":{"type":"object","additionalProperties":false,"required":["title","detail","evidenceIds"],"properties":{"title":{"type":"string","minLength":1,"maxLength":160},"detail":{"type":"string","minLength":1,"maxLength":1200},"evidenceIds":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^E[1-9][0-9]*$"}}}}},
    "experimentHypotheses":{"type":"array","maxItems":10,"items":{"type":"object","additionalProperties":false,"required":["hypothesis","status","evidenceIds"],"properties":{"hypothesis":{"type":"string","minLength":1,"maxLength":800},"status":{"const":"PENDING_VALIDATION"},"evidenceIds":{"type":"array","maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^E[1-9][0-9]*$"}}}}}
  }
}
